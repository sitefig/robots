{
  "route": "/app/versions/",
  "title": "Version history",
  "key": "page.versions",
  "lead": "Every robots.txt we have seen for this domain, with what changed between them.",
  "blocks": [
    {
      "type": "table",
      "key": "block.versionList",
      "endpoint": "/app/data/versions.json",
      "columns": [
        {
          "key": "col.seen",
          "label": "Seen"
        },
        {
          "key": "col.change",
          "label": "Change"
        },
        {
          "key": "col.bots",
          "label": "Bots affected"
        },
        {
          "key": "col.note",
          "label": "Note"
        }
      ]
    }
  ]
}
