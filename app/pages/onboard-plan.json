{
  "route": "/app/onboard/plan/",
  "title": "Choose a plan",
  "key": "page.onboardPlan",
  "lead": "Plans differ by how many domains and competitors you watch, how often we crawl, and where alerts may go.",
  "blocks": [
    {
      "type": "progress",
      "key": "block.onboardProgress",
      "current": 3,
      "items": [
        {
          "key": "onboard.signup",
          "text": "Sign up",
          "href": "/app/signup/"
        },
        {
          "key": "onboard.domain",
          "text": "Your domain",
          "href": "/app/onboard/domain/"
        },
        {
          "key": "onboard.competitors",
          "text": "Competitors",
          "href": "/app/onboard/competitors/"
        },
        {
          "key": "onboard.plan",
          "text": "Plan",
          "href": "/app/onboard/plan/"
        },
        {
          "key": "onboard.crawling",
          "text": "First crawl",
          "href": "/app/onboard/crawling/"
        }
      ]
    },
    {
      "type": "plans",
      "key": "block.plans",
      "endpoint": "/app/data/plans.json",
      "compare": [
        {
          "key": "compare.domains",
          "label": "Domains"
        },
        {
          "key": "compare.competitors",
          "label": "Competitors"
        },
        {
          "key": "compare.frequency",
          "label": "Crawl frequency"
        },
        {
          "key": "compare.channels",
          "label": "Alert channels"
        },
        {
          "key": "compare.reports",
          "label": "Reports"
        }
      ]
    },
    {
      "type": "note",
      "key": "block.checkout",
      "text": "Payment goes through Stripe. If it fails or you change your mind, you come back here with your domain and competitors still in place."
    }
  ],
  "chrome": "onboarding"
}
