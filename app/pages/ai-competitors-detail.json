{
  "route": "/app/ai-competitors/:domain/",
  "title": "Competitor",
  "key": "page.competitorDetail",
  "lead": "What this domain allows, and every time it changed its mind.",
  "blocks": [
    {
      "type": "matrix",
      "key": "block.theirMatrix",
      "endpoint": "/app/data/competitor-matrix.json"
    },
    {
      "type": "list",
      "key": "block.changeFeed",
      "title": "Change feed",
      "endpoint": "/app/data/competitor-feed.json",
      "empty": {
        "key": "empty.feed",
        "text": "Nothing has changed since we started watching."
      }
    },
    {
      "type": "links",
      "key": "block.competitorLinks",
      "items": [
        {
          "key": "link.copyPolicy",
          "text": "Copy this policy into the builder",
          "href": "/app/builder/"
        },
        {
          "key": "link.removeCompetitor",
          "text": "Stop tracking this domain"
        }
      ]
    }
  ]
}
