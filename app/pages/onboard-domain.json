{
  "route": "/app/onboard/domain/",
  "title": "Your domain",
  "key": "page.onboardDomain",
  "lead": "Type the domain and we read its robots.txt while you watch.",
  "blocks": [
    {
      "type": "progress",
      "key": "block.onboardProgress",
      "current": 1,
      "items": [
        {
          "key": "onboard.signup",
          "text": "Sign up",
          "href": "/app/signup/"
        },
        {
          "key": "onboard.domain",
          "text": "Your domain",
          "href": "/app/onboard/domain/"
        },
        {
          "key": "onboard.competitors",
          "text": "Competitors",
          "href": "/app/onboard/competitors/"
        },
        {
          "key": "onboard.plan",
          "text": "Plan",
          "href": "/app/onboard/plan/"
        },
        {
          "key": "onboard.crawling",
          "text": "First crawl",
          "href": "/app/onboard/crawling/"
        }
      ]
    },
    {
      "type": "form",
      "key": "block.domainForm",
      "fields": [
        {
          "key": "field.domain",
          "label": "Domain",
          "type": "text",
          "placeholder": "example.com"
        }
      ],
      "submit": {
        "key": "action.fetch",
        "text": "Fetch the file"
      }
    },
    {
      "type": "preview",
      "key": "block.robotsPreview",
      "title": "What we found",
      "endpoint": "/app/data/preview.json",
      "empty": {
        "key": "empty.preview",
        "text": "The preview appears as soon as you enter a domain."
      }
    },
    {
      "type": "note",
      "key": "block.ownership",
      "text": "Proving you own it can wait. You need it before we show traffic figures, and connecting Search Console later does it for you."
    }
  ],
  "chrome": "onboarding"
}
