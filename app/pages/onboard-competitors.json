{
  "route": "/app/onboard/competitors/",
  "title": "Competitors",
  "key": "page.onboardCompetitors",
  "lead": "The comparison is the part people come back for. Pick a few now, change them whenever.",
  "blocks": [
    {
      "type": "progress",
      "key": "block.onboardProgress",
      "current": 2,
      "items": [
        {
          "key": "onboard.signup",
          "text": "Sign up",
          "href": "/app/signup/"
        },
        {
          "key": "onboard.domain",
          "text": "Your domain",
          "href": "/app/onboard/domain/"
        },
        {
          "key": "onboard.competitors",
          "text": "Competitors",
          "href": "/app/onboard/competitors/"
        },
        {
          "key": "onboard.plan",
          "text": "Plan",
          "href": "/app/onboard/plan/"
        },
        {
          "key": "onboard.crawling",
          "text": "First crawl",
          "href": "/app/onboard/crawling/"
        }
      ]
    },
    {
      "type": "list",
      "key": "block.suggested",
      "title": "Suggested",
      "endpoint": "/app/data/suggested-competitors.json",
      "lead": "Found from your site and your market. Untick anything that is not a competitor."
    },
    {
      "type": "form",
      "key": "block.addCompetitor",
      "fields": [
        {
          "key": "field.competitor",
          "label": "Add one yourself",
          "type": "text",
          "placeholder": "competitor.example"
        }
      ],
      "submit": {
        "key": "action.add",
        "text": "Add"
      }
    },
    {
      "type": "actions",
      "key": "block.competitorStep",
      "items": [
        {
          "key": "action.continue",
          "text": "Continue",
          "variant": "primary"
        },
        {
          "key": "action.skip",
          "text": "Skip for now",
          "note": "You can add competitors at any time"
        }
      ]
    }
  ],
  "chrome": "onboarding"
}
