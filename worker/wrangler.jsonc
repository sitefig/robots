/**
 * Cloudflare Worker configuration. JSONC is the format Wrangler now expects;
 * it replaced the wrangler.toml this file was converted from.
 *
 * Deployed by .github/workflows/deploy-worker.yml when worker/ changes on
 * main, or by hand with `npx wrangler deploy` from this folder.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robots-proxy",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",

  /**
   * Workers Logs, so a failing fetch can be read back instead of guessed at.
   * It is set here rather than only in the dashboard: a deploy writes the
   * configuration it is given, and a missing block would turn logging off
   * again. head_sampling_rate 1 keeps every request; the free allowance is
   * 200,000 log events a day, far above this worker's traffic.
   */
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    /**
     * Kill switch: flip to "true" in the dashboard (Settings > Variables) to
     * make the worker answer 503 to everything at once, without a deploy.
     * Requests still count against the daily quota, but nothing is fetched.
     */
    "PAUSED": "false",

    /**
     * Browser origins allowed to call this worker, comma-separated, exact
     * match. Lists the GitHub Pages origin and the custom domain; origin
     * only, so language sub-paths need nothing.
     */
    "ALLOWED_ORIGINS": "http://localhost:8888,http://127.0.0.1:8888,https://sus.bot,https://www.sus.bot,https://sitefig.github.io"
  },

  /**
   * Rate limits (free, no extra service). Period may only be 10 or 60
   * seconds. PER_IP stops one client from hogging the quota; GLOBAL caps the
   * worker as a whole so a distributed abuser cannot burn the Free plan's
   * 100k requests a day. The front end's access check sends about 31
   * requests at 3 in flight, which fits.
   */
  "ratelimits": [
    {
      "name": "PER_IP",
      "namespace_id": "1001",
      "simple": { "limit": 90, "period": 60 }
    },
    {
      "name": "GLOBAL",
      "namespace_id": "1002",
      "simple": { "limit": 40, "period": 10 }
    }
  ]
}
